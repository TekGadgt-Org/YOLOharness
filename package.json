{
  "name": "yoloharness",
  "version": "0.1.1",
  "description": "A bounded, inspectable one-shot agent runtime",
  "type": "module",
  "bin": { "yolo": "src/cli.mjs" },
  "files": ["package.json", "install.mjs", "src", "assets/runtime"],
  "scripts": { "test": "NODE_ENV=test node --test test/*.test.mjs", "test:docker": "YOLO_REAL_DOCKER=1 node --test --test-concurrency=1 test/real-docker*.test.mjs" }
}
